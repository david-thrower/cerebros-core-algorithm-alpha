					"simStepLabel": "Define Base Model with RoPE",
					"simStepDescription": "A base model architecture is defined. It includes a standard token embedding layer followed by an `InterleavedRoPE` layer. `InterleavedRoPE` applies rotary positional embeddings, which is an efficient way to encode token position information, especially for long sequences.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "generative-proof-of-concept-CPU-preprocessing-in-memory.py",
						"startLine": "272",
