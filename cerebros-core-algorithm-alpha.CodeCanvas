		"18f0869f-a36d-4c1d-b689-ee64e33259fb": {
			"path": "18f0869f-a36d-4c1d-b689-ee64e33259fb",
			"cellName": "Materialize InputUnit with Base Model - units.py:L107-119",
			"cellId": "18f0869f-a36d-4c1d-b689-ee64e33259fb",
			"visible": true,
			"parentCellId": "7b9394cf-4e6d-420d-99a3-3fad0b7575c0"
		},
		"cerebros/units/units.py-simstep-316a1728-a5cc-4541-8c0f-9481cf94db9c": {
			"path": "cerebros/units/units.py-simstep-316a1728-a5cc-4541-8c0f-9481cf94db9c",
			"fileName": "units.py",
			"wiki": "The `materialize` method of the `InputUnit` is called. It creates a `tf.keras.layers.Input`. Crucially, it checks if a base model was provided. Since it was, it connects the input layer directly to the base model, effectively making the entire pre-trained BERT model the first functional layer of the network. The output of this operation is the embedding tensor from the BERT model.",
			"cellName": "Materialize InputUnit with Base Model - units.py:L107-119",
			"cellId": "18f0869f-a36d-4c1d-b689-ee64e33259fb",
			"visible": true,
			"startLine": 107,
			"endLine": 119,
			"parentCellId": "7b9394cf-4e6d-420d-99a3-3fad0b7575c0",
			"parentPath": "cerebros/units/units.py",
			"simSteps": [
				{
					"simulationKey": "Advanced Text Classification by Fine-tuning Transformer-based Embeddings",
					"simStepId": "316a1728-a5cc-4541-8c0f-9481cf94db9c"
				}
			]
		},
		"2a42e08a-be9d-4e57-a6d5-30b4721e92cc": {
			"path": "2a42e08a-be9d-4e57-a6d5-30b4721e92cc",
			"cellName": "Final Model Assembly - neural_network_future.py:L323-326",
			"cellId": "2a42e08a-be9d-4e57-a6d5-30b4721e92cc",
			"visible": true,
			"parentCellId": "926ba972-b1e2-460c-bd80-157264c084d2"
		},
		"cerebros/neuralnetworkfuture/neural_network_future.py-simstep-f36c7a28-a9d8-4248-bc16-66b1eb635a8f": {
			"path": "cerebros/neuralnetworkfuture/neural_network_future.py-simstep-f36c7a28-a9d8-4248-bc16-66b1eb635a8f",
			"fileName": "neural_network_future.py",
			"wiki": "The `NeuralNetworkFuture` assembles the complete computational graph. It takes the original string input tensor (from `InputUnit.raw_input`) and connects it to the output tensor of the final, randomly generated classification head. The base model is implicitly part of this graph because its output tensor is the input to the subsequent Cerebros-generated layers.",
			"cellName": "Final Model Assembly - neural_network_future.py:L323-326",
			"cellId": "2a42e08a-be9d-4e57-a6d5-30b4721e92cc",
			"visible": true,
			"startLine": 323,
			"endLine": 326,
			"parentCellId": "926ba972-b1e2-460c-bd80-157264c084d2",
			"parentPath": "cerebros/neuralnetworkfuture/neural_network_future.py",
			"simSteps": [
				{
					"simulationKey": "Advanced Text Classification by Fine-tuning Transformer-based Embeddings",
					"simStepId": "f36c7a28-a9d8-4248-bc16-66b1eb635a8f"
				}
			]
		},
		"c08a85f4-ee02-42b9-a287-30de66084bbf": {
			"path": "c08a85f4-ee02-42b9-a287-30de66084bbf",
			"cellName": "Model Training (Fine-tuning) - simple_cerebros_random_search.py:L498-505",
			"cellId": "c08a85f4-ee02-42b9-a287-30de66084bbf",
			"visible": true,
			"parentCellId": "bfb22ade-414f-4e25-8e20-87089edfdc1d"
		},
		"cerebros/simplecerebrosrandomsearch/simple_cerebros_random_search.py-simstep-4ca6cfa9-8126-41e2-811d-8b532d88f3bd": {
			"path": "cerebros/simplecerebrosrandomsearch/simple_cerebros_random_search.py-simstep-4ca6cfa9-8126-41e2-811d-8b532d88f3bd",
			"fileName": "simple_cerebros_random_search.py",
			"wiki": "The `fit` method is executed. TensorFlow computes gradients and updates weights for the entire model. Because the BERT encoder's `trainable` property was set to `True`, its weights are updated along with the weights of the newly generated classification layers. This process fine-tunes the pre-trained transformer for the specific spam detection task.",
			"cellName": "Model Training (Fine-tuning) - simple_cerebros_random_search.py:L498-505",
			"cellId": "c08a85f4-ee02-42b9-a287-30de66084bbf",
			"visible": true,
			"startLine": 498,
			"endLine": 505,
