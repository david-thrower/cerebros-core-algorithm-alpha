					"diagramNodeId": "5554c56c-27ec-484e-94bf-55983e47d2e3",
					"simStepLabel": "Log Phase I-a Perplexity Metric",
					"simStepDescription": "After Phase I-a training completes, the resulting best perplexity score is logged to MLflow using `mlflow.log_metric()`. This captures the performance of the model found during the architecture search.",
					"isEdge": 0,
