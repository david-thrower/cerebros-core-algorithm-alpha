					"inputDataExample": "{\"training_data\": \"<tf.Tensor>\", \"labels\": \"<tf.Tensor>\", \"base_models\": [\"<tf.keras.Model object>\"], \"metric_to_rank_by\": \"perplexity\", \"learning_rate\": 0.0045, ...}",
					"outputDataExample": "{\"training_data\": \"<tf.Tensor>\", \"labels\": \"<tf.Tensor>\", \"base_models\": [\"<tf.keras.Model object>\"], \"metric_to_rank_by\": \"perplexity\", \"learning_rate\": 0.0045, ...}"
				},
				{
					"simStepId": "adb60798-d3e7-4a41-85a6-9a051e7a5889",
