					},
					"inputDataExample": "{\n  \"params\": {\n    \"PHASE_I_A_SAMPLES_TO_CREATE\": 10,\n    \"MAX_SEQ_LENGTH\": 40,\n    \"learning_rate\": 0.0051,\n    \"epochs\": 65,\n    \"activation\": \"relu\"\n  }\n}",
					"outputDataExample": "{\n  \"status\": \"SUCCESS\"\n}"
				},
				{
					"simStepId": "fda45b27-cf29-4cce-9142-a68a8cd7e644",
					"diagramNodeId": "1dcefdb1-4359-40a7-ad7f-d482c6d927bc",
					"simStepLabel": "Execute Phase I-a Training",
					"simStepDescription": "The script initiates the first phase of model training by calling `cerebros_automl.run_random_search()`. This function performs a neural architecture search and returns the best performance metric found.",
