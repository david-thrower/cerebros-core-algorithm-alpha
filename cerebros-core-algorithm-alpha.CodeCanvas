					"inputDataExample": "{\n  \"run_name\": \"trial_0\",\n  \"tags\": {\n    \"phase\": \"poc\",\n    \"script\": \"generative-proof-of-concept-CPU-preprocessing-in-memory.py\",\n    \"trial_number\": \"0\",\n    \"Start_time\": \"2023-10-27T10:00:00.123456Z\"\n  }\n}",
