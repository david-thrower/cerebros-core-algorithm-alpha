		"Scalable Hyperparameter Optimization with MLOps Tools": {
			"name": "Scalable Hyperparameter Optimization with MLOps Tools",
			"simSteps": [
				{
					"simStepId": "83a4230e-dd38-4d06-ad3a-2e691e1b9824",
					"diagramNodeId": "320af148-a754-4f7a-8a8c-56271c8d1a8d",
					"simStepLabel": "Flow 1: Define Katib Experiment",
					"simStepDescription": "A user defines a Kubeflow Katib `Experiment` in a YAML file. This specification includes the hyperparameter search space (`parameters`), the optimization algorithm (`bayesianoptimization`), the objective metric to minimize (`val-root-mean-squared-error`), and a `trialTemplate` that defines how to run each training job.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "kubeflow-pipeline/amesnopreprcoessing0002a-vnrny.katib.yaml",
						"startLine": "1",
						"endLine": "134",
						"relevantVariables": [
							"kind: Experiment",
							"spec.algorithm",
							"spec.objective",
							"spec.parameters",
							"spec.trialTemplate"
						]
					},
					"inputDataExample": "null",
					"outputDataExample": "{\n  \"apiVersion\": \"kubeflow.org/v1beta1\",\n  \"kind\": \"Experiment\",\n  \"metadata\": {\n    \"name\": \"amesnopreprcoessing0002a-vnrny\",\n    \"namespace\": \"kubeflow-user\"\n  },\n  \"spec\": {\n    \"objective\": {\n      \"type\": \"minimize\",\n      \"objectiveMetricName\": \"val-root-mean-squared-error\"\n    },\n    \"algorithm\": {\n      \"algorithmName\": \"bayesianoptimization\"\n    },\n    \"parallelTrialCount\": 3,\n    \"maxTrialCount\": 1000,\n    \"parameters\": [\n      {\n        \"name\": \"learning_rate\",\n        \"parameterType\": \"double\",\n        \"feasibleSpace\": {\n          \"min\": \"0.0001\",\n          \"max\": \"0.3\"\n        }\n      }\n    ]\n  }\n}"
				},
				{
					"simStepId": "10d6a255-7056-4d5c-a948-d2a12fd68cfe",
					"diagramNodeId": "544eaf7b-384c-4479-83d3-d788ffb6294a",
					"simStepLabel": "Flow 1: Submit Experiment to Kubernetes",
					"simStepDescription": "The user applies the YAML file to a Kubernetes cluster where Kubeflow is installed, typically using a command like `kubectl apply -f amesnopreprcoessing0002a-vnrny.katib.yaml`. This action sends the experiment definition to the Kubernetes API server, which then creates the `Experiment` resource.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "kubeflow-pipeline/amesnopreprcoessing0002a-vnrny.katib.yaml",
						"startLine": "1",
						"endLine": "134",
						"relevantVariables": [
							"conceptual: User applies YAML via kubectl"
						]
					},
					"inputDataExample": "{\n  \"apiVersion\": \"kubeflow.org/v1beta1\",\n  \"kind\": \"Experiment\",\n  \"metadata\": {\n    \"name\": \"amesnopreprcoessing0002a-vnrny\",\n    \"namespace\": \"kubeflow-user\"\n  },\n  \"spec\": {\n    \"objective\": {\n      \"type\": \"minimize\",\n      \"objectiveMetricName\": \"val-root-mean-squared-error\"\n    },\n    \"algorithm\": {\n      \"algorithmName\": \"bayesianoptimization\"\n    },\n    \"parallelTrialCount\": 3,\n    \"maxTrialCount\": 1000,\n    \"parameters\": [\n      {\n        \"name\": \"learning_rate\",\n        \"parameterType\": \"double\",\n        \"feasibleSpace\": {\n          \"min\": \"0.0001\",\n          \"max\": \"0.3\"\n        }\n      }\n    ]\n  }\n}",
					"outputDataExample": "{\n  \"apiVersion\": \"kubeflow.org/v1beta1\",\n  \"kind\": \"Experiment\",\n  \"metadata\": {\n    \"name\": \"amesnopreprcoessing0002a-vnrny\",\n    \"namespace\": \"kubeflow-user\"\n  },\n  \"spec\": {\n    \"objective\": {\n      \"type\": \"minimize\",\n      \"objectiveMetricName\": \"val-root-mean-squared-error\"\n    },\n    \"algorithm\": {\n      \"algorithmName\": \"bayesianoptimization\"\n    },\n    \"parallelTrialCount\": 3,\n    \"maxTrialCount\": 1000,\n    \"parameters\": [\n      {\n        \"name\": \"learning_rate\",\n        \"parameterType\": \"double\",\n        \"feasibleSpace\": {\n          \"min\": \"0.0001\",\n          \"max\": \"0.3\"\n        }\n      }\n    ]\n  }\n}"
				},
				{
					"simStepId": "5be0b7e7-b96d-47b7-82e8-1c87a588d57a",
					"diagramNodeId": "fdeab34a-7f82-4096-9845-11681ba0a60c",
					"simStepLabel": "Flow 1: Katib Controller Generates Trial Parameters",
					"simStepDescription": "The Katib controller, a component of Kubeflow, detects the new `Experiment` resource. It uses the specified Bayesian Optimization algorithm to select a set of hyperparameter values from the defined search space for the first trial.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "kubeflow-pipeline/amesnopreprcoessing0002a-vnrny.katib.yaml",
						"startLine": "7",
						"endLine": "17",
						"relevantVariables": [
							"algorithmName: bayesianoptimization",
							"algorithmSettings"
						]
					},
					"inputDataExample": "{\n  \"parameters\": [\n    {\n      \"name\": \"activation\",\n      \"parameterType\": \"categorical\",\n      \"feasibleSpace\": {\n        \"list\": [\"elu\", \"gelu\", \"relu\"]\n      }\n    },\n    {\n      \"name\": \"learning_rate\",\n      \"parameterType\": \"double\",\n      \"feasibleSpace\": {\n        \"min\": \"0.0001\",\n        \"max\": \"0.3\"\n      }\n    }\n  ]\n}",
					"outputDataExample": "{\n  \"trialParameters\": {\n    \"activation\": \"gelu\",\n    \"learning_rate\": 0.028\n  }\n}"
				},
				{
					"simStepId": "2fae05bb-ecf0-4b6f-993f-566ea524b3e7",
					"diagramNodeId": "e48d877e-1e9a-4cc8-96aa-39f95c6070c2",
					"simStepLabel": "Flow 1: Katib Controller Launches Trial Job",
					"simStepDescription": "The Katib controller populates the `trialTemplate` with the generated hyperparameter values and creates a Kubernetes Job to execute the trial. The parameters are passed to the job's container.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "kubeflow-pipeline/amesnopreprcoessing0002a-vnrny.katib.yaml",
						"startLine": "82",
						"endLine": "134",
						"relevantVariables": [
							"trialTemplate",
							"trialParameters",
							"trialSpec"
						]
					},
					"inputDataExample": "{\n  \"trialParameters\": {\n    \"activation\": \"gelu\",\n    \"learning_rate\": 0.028,\n    \"batch_size\": 128\n  }\n}",
					"outputDataExample": "{\n  \"trialParameters\": {\n    \"activation\": \"gelu\",\n    \"learning_rate\": 0.028,\n    \"batch_size\": 128\n  }\n}"
				},
				{
					"simStepId": "2b30a4ea-592d-4715-958c-6682fe42aabe",
					"diagramNodeId": "28447c36-c706-419a-9c50-d8fc86c16a93",
					"simStepLabel": "Flow 1: Trial Job Executes KFP Run",
					"simStepDescription": "The Kubernetes Job starts a container which executes the specified python command. This command, `create_and_wait_kfp_run`, initiates a Kubeflow Pipeline run, passing the trial's hyperparameters to the pipeline. The pipeline contains the actual logic for training the Cerebros model.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "kubeflow-pipeline/amesnopreprcoessing0002a-vnrny.katib.yaml",
						"startLine": "119",
