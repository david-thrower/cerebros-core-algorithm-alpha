		"cerebros/neuralnetworkfuture/neural_network_future.py-simstep-cd54e7fb-375e-483c-8ed6-7de74b0f7838": {
			"path": "cerebros/neuralnetworkfuture/neural_network_future.py-simstep-cd54e7fb-375e-483c-8ed6-7de74b0f7838",
			"fileName": "neural_network_future.py",
			"wiki": "The `NeuralNetworkFuture` class is instantiated to define the high-level architecture of a candidate neural network. It receives and stores the `base_models` and creates an `InputLevel` object, passing the base model to it. The `InputLevel` will represent the entry point of the network.",
			"cellName": "Initialize NeuralNetworkFuture - neural_network_future.py:L25-123",
			"cellId": "6765b13c-be65-420f-ae93-d3fb08eec8cd",
			"visible": true,
