		"Advanced Text Classification by Fine-tuning Transformer-based Embeddings": {
			"name": "Advanced Text Classification by Fine-tuning Transformer-based Embeddings",
			"simSteps": [
				{
					"simStepId": "f7512f7c-77fb-4f56-8e0d-652dadb4934c",
					"diagramNodeId": "1514608b-dfcb-4f50-97cc-a72d7f5e49c0",
					"simStepLabel": "BERT Base Model Construction",
					"simStepDescription": "A pre-trained BERT model from TensorFlow Hub is configured to serve as the base for text embedding. An input layer for string data is defined, connected to a preprocessor and an encoder from the hub. The output of this chain (`pooled_output`) is then wrapped in a Keras Model, which will be used as the feature extractor.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "text-class-ham-or-spam.py",
						"startLine": "80",
						"endLine": "91",
						"relevantVariables": [
							"text_input",
							"preprocessor",
							"encoder",
							"pooled_output",
							"embedding_model"
						]
					},
					"inputDataExample": "{\n  \"text_input_shape\": [],\n  \"text_input_dtype\": \"tf.string\",\n  \"preprocessor_url\": \"https://kaggle.com/models/tensorflow/bert/TensorFlow2/en-uncased-preprocess/3\",\n  \"encoder_url\": \"https://www.kaggle.com/models/tensorflow/bert/TensorFlow2/bert-en-uncased-l-10-h-128-a-2/2\"\n}",
					"outputDataExample": "{\n  \"embedding_model\": \"<tf.keras.Model object>\",\n  \"model_input\": \"KerasTensor(type_spec=TensorSpec(shape=(), dtype=tf.string, name='input_1'), name='input_1', description='...')\",\n  \"model_output\": \"KerasTensor(type_spec=TensorSpec(shape=(None, 128), dtype=tf.float32, name='keras_layer_1'), name='keras_layer_1/Identity:0', description='...')\"\n}"
				},
				{
					"simStepId": "06202ee6-14ec-4c55-90b5-efc22b7ac6f5",
					"diagramNodeId": "237fd5fe-112d-4b98-9ed7-d397778051f2",
					"simStepLabel": "Pass Embedding Model to AutoML",
					"simStepDescription": "The constructed BERT `embedding_model` is passed as a list to the `base_models` parameter during the initialization of the `SimpleCerebrosRandomSearch` class. This injects the pre-trained model into the neural architecture search process.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "text-class-ham-or-spam.py",
						"startLine": "168",
						"endLine": "168",
						"relevantVariables": [
							"base_models",
							"embedding_model"
						]
					},
					"inputDataExample": "{\n  \"base_models\": [\"<tf.keras.Model object>\"]\n}",
					"outputDataExample": "{\n  \"base_models\": [\"<tf.keras.Model object>\"]\n}"
				},
				{
					"simStepId": "85dd9b65-c230-4e2a-81e3-ef8d349f3877",
					"diagramNodeId": "13ef7a86-7904-478d-8b47-cc1ebe37fbd2",
					"simStepLabel": "Initialize SimpleCerebrosRandomSearch",
					"simStepDescription": "The `SimpleCerebrosRandomSearch` constructor is called. It stores the provided `base_models`, along with training data, labels, and various hyperparameters for the architecture search, preparing for the search execution.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "cerebros/simplecerebrosrandomsearch/simple_cerebros_random_search.py",
						"startLine": "276",
						"endLine": "412",
						"relevantVariables": [
							"__init__",
							"self.base_models"
						]
					},
					"inputDataExample": "{\n  \"unit_type\": \"DenseUnit\",\n  \"input_shapes\": [[]],\n  \"output_shapes\": [1],\n  \"training_data\": [\"<tf.Tensor: shape=(200, 1), dtype=string>\"],\n  \"labels\": [\"<tf.Tensor: shape=(200,), dtype=float32>\"],\n  \"metric_to_rank_by\": \"val_binary_accuracy\",\n  \"base_models\": [\"<tf.keras.Model object>\"]\n}",
					"outputDataExample": "{\n  \"cerebros_automl_instance\": \"<SimpleCerebrosRandomSearch object>\",\n  \"self.base_models\": [\"<tf.keras.Model object>\"]\n}"
				},
				{
					"simStepId": "18aa5eb4-bf29-4b9a-8d22-83a9b6ef5599",
					"diagramNodeId": "b79cdda7-982d-4905-b408-b1365ac63ee1",
					"simStepLabel": "Pass Base Model to NeuralNetworkFuture",
					"simStepDescription": "Inside the search loop, `run_moity_permutations` instantiates `NeuralNetworkFuture`, passing the stored `base_models` list to its constructor. This transfers the responsibility of integrating the base model to the component that designs the network architecture.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "cerebros/simplecerebrosrandomsearch/simple_cerebros_random_search.py",
						"startLine": "465",
						"endLine": "465",
						"relevantVariables": [
							"base_models",
							"NeuralNetworkFuture"
						]
					},
					"inputDataExample": "{\n  \"base_models\": [\"<tf.keras.Model object>\"]\n}",
					"outputDataExample": "{\n  \"base_models\": [\"<tf.keras.Model object>\"]\n}"
				},
				{
					"simStepId": "cd54e7fb-375e-483c-8ed6-7de74b0f7838",
					"diagramNodeId": "6765b13c-be65-420f-ae93-d3fb08eec8cd",
					"simStepLabel": "Initialize NeuralNetworkFuture",
					"simStepDescription": "The `NeuralNetworkFuture` class is instantiated to define the high-level architecture of a candidate neural network. It receives and stores the `base_models` and creates an `InputLevel` object, passing the base model to it. The `InputLevel` will represent the entry point of the network.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "cerebros/neuralnetworkfuture/neural_network_future.py",
						"startLine": "25",
						"endLine": "123",
						"relevantVariables": [
							"__init__",
							"self.base_models",
							"InputLevel"
						]
					},
					"inputDataExample": "{\n  \"input_shapes\": [[]],\n  \"output_shapes\": [1],\n  \"neural_network_spec\": {\"0\": [[{\"1\": \"<class 'cerebros.units.units.InputUnit'>\"}]]},\n  \"project_name\": \"2024_01_01_12_00_cerebros_auto_ml_test_meta_12345\",\n  \"base_models\": [\"<tf.keras.Model object>\"]\n}",
					"outputDataExample": "{\n  \"nnf_instance\": \"<NeuralNetworkFuture object>\",\n  \"self.base_models\": [\"<tf.keras.Model object>\"]\n}"
				},
				{
					"simStepId": "721c8117-d09c-439a-abdb-b536d4d747dd",
					"diagramNodeId": "f2ca7ba9-6802-43a6-90e4-62165e7eef03",
					"simStepLabel": "Pass Base Model to InputUnit",
					"simStepDescription": "During the parsing of the input level, an `InputUnit` is created. The list of `base_models` is passed down from the `InputLevel` to the `InputUnit` constructor, making the pre-trained model available at the specific input node of the network graph.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "cerebros/levels/levels.py",
						"startLine": "317",
						"endLine": "317",
						"relevantVariables": [
							"InputUnit",
							"base_models"
						]
					},
					"inputDataExample": "{\n  \"base_models\": [\"<tf.keras.Model object>\"]\n}",
					"outputDataExample": "{\n  \"base_models\": [\"<tf.keras.Model object>\"]\n}"
				},
				{
					"simStepId": "316a1728-a5cc-4541-8c0f-9481cf94db9c",
					"diagramNodeId": "18f0869f-a36d-4c1d-b689-ee64e33259fb",
					"simStepLabel": "Materialize InputUnit with Base Model",
					"simStepDescription": "The `materialize` method of the `InputUnit` is called. It creates a `tf.keras.layers.Input`. Crucially, it checks if a base model was provided. Since it was, it connects the input layer directly to the base model, effectively making the entire pre-trained BERT model the first functional layer of the network. The output of this operation is the embedding tensor from the BERT model.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "cerebros/units/units.py",
						"startLine": "107",
						"endLine": "119",
						"relevantVariables": [
							"materialize",
							"self.raw_input",
							"self.base_models",
							"self.neural_network_layer"
						]
					},
					"inputDataExample": "{\n  \"self.input_shape\": [],\n  \"self.train_data_dtype\": \"tf.string\",\n  \"self.base_models\": [\"<tf.keras.Model object>\"]\n}",
					"outputDataExample": "{\n  \"self.raw_input\": \"<KerasTensor: shape=(None,) dtype=string>\",\n  \"self.neural_network_layer\": \"<KerasTensor: shape=(None, 128) dtype=float32>\"\n}"
				},
				{
					"simStepId": "c8adae8a-f7e2-45bf-8da5-42045ed0b224",
					"diagramNodeId": "38b3383a-322a-4b39-a020-67d54306da27",
					"simStepLabel": "Transmit Materialized Layers for Assembly",
					"simStepDescription": "The materialized layers from all units, including the output tensor from the base model in the `InputUnit`, are collected by the `NeuralNetworkFuture` to prepare for the final model construction.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "cerebros/neuralnetworkfuture/neural_network_future.py",
						"startLine": "295",
						"endLine": "310",
						"relevantVariables": [
							"materialized_neural_network_inputs",
							"materialized_neural_network_outputs"
						]
					},
					"inputDataExample": "{\n  \"materialized_inputs\": [\"<KerasTensor: shape=(None,) dtype=string>\"],\n  \"materialized_outputs\": [\"<KerasTensor: shape=(None, 1) dtype=float32>\"]\n}",
					"outputDataExample": "{\n  \"materialized_inputs\": [\"<KerasTensor: shape=(None,) dtype=string>\"],\n  \"materialized_outputs\": [\"<KerasTensor: shape=(None, 1) dtype=float32>\"]\n}"
				},
				{
					"simStepId": "f36c7a28-a9d8-4248-bc16-66b1eb635a8f",
					"diagramNodeId": "2a42e08a-be9d-4e57-a6d5-30b4721e92cc",
					"simStepLabel": "Final Model Assembly",
					"simStepDescription": "The `NeuralNetworkFuture` assembles the complete computational graph. It takes the original string input tensor (from `InputUnit.raw_input`) and connects it to the output tensor of the final, randomly generated classification head. The base model is implicitly part of this graph because its output tensor is the input to the subsequent Cerebros-generated layers.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "cerebros/neuralnetworkfuture/neural_network_future.py",
						"startLine": "323",
						"endLine": "326",
						"relevantVariables": [
