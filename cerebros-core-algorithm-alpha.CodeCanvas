							"self.validation_data"
						]
					},
					"inputDataExample": "{\"validation_split\": 0.0, \"validation_data\": \"(<tf.Tensor 'Const:0' shape=(510, 36)>, <tf.Tensor 'Const:0' shape=(510,)>)\"}",
					"outputDataExample": "{\"self.validation_split\": 0.0, \"self.validation_data\": \"(<tf.Tensor 'Const:0' shape=(510, 36)>, <tf.Tensor 'Const:0' shape=(510,)>)\"}"
				},
				{
					"simStepId": "724aa7d6-bca2-4b2c-b9dd-efd14949e1d7",
					"diagramNodeId": "a2f060a8-2bce-493d-80eb-bb57593c95d6",
					"simStepLabel": "Data Flow: Pass Stored Data to Model Training",
					"simStepDescription": "During the search process, the `run_moity_permutations` method is called, which then invokes the Keras `model.fit()` method. The stored `self.validation_split` and `self.validation_data` attributes are passed directly to `model.fit()`.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "cerebros/simplecerebrosrandomsearch/simple_cerebros_random_search.py",
						"startLine": "504",
						"endLine": "505",
						"relevantVariables": [
							"neural_network.fit",
							"self.validation_split",
							"self.validation_data"
						]
					},
					"inputDataExample": "{\"self.validation_split\": 0.0, \"self.validation_data\": \"(<tf.Tensor 'Const:0' shape=(510, 36)>, <tf.Tensor 'Const:0' shape=(510,)>)\"}",
					"outputDataExample": "{\"validation_split\": 0.0, \"validation_data\": \"(<tf.Tensor 'Const:0' shape=(510, 36)>, <tf.Tensor 'Const:0' shape=(510,)>)\"}"
				},
				{
					"simStepId": "5fd2a0e4-8911-4a15-b354-dc6fe1faeda9",
					"diagramNodeId": "a79e41fc-2d5a-4f1e-809f-023e9198ca61",
					"simStepLabel": "Train Model with Custom Validation Set",
					"simStepDescription": "The Keras `model.fit()` function receives the training data, along with `validation_split=0.0` and the custom `validation_data`. Keras's internal logic prioritizes `validation_data` when it is provided, using it for validation metrics and ignoring the `validation_split` parameter. This completes the use case by training on one pre-split set and evaluating on another.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "cerebros/simplecerebrosrandomsearch/simple_cerebros_random_search.py",
						"startLine": "498",
						"endLine": "505",
						"relevantVariables": [
							"neural_network.fit",
							"self.training_data",
							"self.labels",
							"self.epochs",
							"self.batch_size",
							"self.validation_split",
							"self.validation_data"
						]
					},
					"inputDataExample": "{\"x\": \"<training_data>\", \"y\": \"<labels>\", \"validation_split\": 0.0, \"validation_data\": \"<custom_validation_set>\"}",
					"outputDataExample": "{\"history\": {\"loss\": [5.4, 3.2], \"val_loss\": [4.8, 3.9], \"val_root_mean_squared_error\": [30000.0, 25000.0]}}"
				}
			],
			"description": "<ul><li>The library demonstrates and supports methods for advanced data splitting beyond simple random splits</li><li>The <code>hash_based_split</code> function in <code>regression-example-ames-no-preproc-val-set</li><li>py</code> ensures that identical data samples always land in the same split (train or validation), preventing subtle forms of data leakage</li><li>Users can provide their own pre-split validation data directly to <code>SimpleCerebrosRandomSearch</code> by setting <code>validation_split=0</li><li>0</code> and passing data to the <code>validation_data</code> parameter, giving full control over the evaluation process</li></ul>",
