			"fileName": "generative-proof-of-concept-CPU-preprocessing-in-memory.py",
			"wiki": "The objective function returns the final metric that Optuna is trying to minimize. Optuna's sampler uses this value to update its internal model and decide which hyperparameter regions to explore in subsequent trials.",
			"cellName": "Flow 2: Return Metric to Optuna - generative-proof-of-concept-CPU-preprocessing-in-memory.py:L845",
			"cellId": "875a150d-56bc-47cb-904a-dedcb2c16a7b",
			"visible": true,
