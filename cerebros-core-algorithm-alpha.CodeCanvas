		"4427b123-4a2b-49ae-9db2-e1eb0f109cf6": {
			"path": "4427b123-4a2b-49ae-9db2-e1eb0f109cf6",
			"cellName": "Start Nested MLflow Run for Optuna Trial - generative-proof-of-concept-CPU-preprocessing-in-memory.py:L216",
			"cellId": "4427b123-4a2b-49ae-9db2-e1eb0f109cf6",
			"visible": true,
			"parentCellId": "4fc2fc00-1cfb-40a0-8f3b-13c06a963c99"
