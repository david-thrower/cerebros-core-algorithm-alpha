					"outputDataExample": "{\"train_df\": {\"MSSubClass\": [60], ...}, \"train_labels\": [208500, ...], \"val_df\": {\"MSSubClass\": [20], ...}, \"val_labels\": [181500, ...]}"
				},
				{
					"simStepId": "3ac85ad9-25ce-4ead-b44b-f3ccb74711c6",
					"diagramNodeId": "97cf1250-5caf-42be-bfab-5cb9a0cec7f3",
					"simStepLabel": "Initialize SimpleCerebrosRandomSearch",
					"simStepDescription": "The main script initializes the `SimpleCerebrosRandomSearch` class. Crucially, it passes the pre-split training data, sets `validation_split=0.0` to disable automatic splitting, and provides the pre-split validation data directly via the `validation_data` parameter.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "regression-example-ames-no-preproc-val-set.py",
