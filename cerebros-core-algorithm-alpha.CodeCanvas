							"validation_split",
							"validation_data"
						]
					},
					"inputDataExample": "{\"training_data\": \"...\", \"labels\": \"...\", \"validation_split\": 0.0, \"validation_data\": \"(val_x, val_labels)\"}",
					"outputDataExample": "{\"training_data\": \"...\", \"labels\": \"...\", \"validation_split\": 0.0, \"validation_data\": \"(val_x, val_labels)\"}"
				},
				{
					"simStepId": "9b03f0d0-534f-49ec-872e-48182216e5d1",
					"diagramNodeId": "480bd852-1389-4821-954b-9c11e5b1a966",
					"simStepLabel": "Store Pre-Split Validation Data",
					"simStepDescription": "The `__init__` method of `SimpleCerebrosRandomSearch` receives the parameters and assigns them to instance attributes. `self.validation_split` is set to 0.0, and `self.validation_data` now holds the custom validation set tuple.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "cerebros/simplecerebrosrandomsearch/simple_cerebros_random_search.py",
						"startLine": "368",
						"endLine": "369",
						"relevantVariables": [
