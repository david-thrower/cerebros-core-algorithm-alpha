							"val_labels"
						]
					},
					"inputDataExample": "{\"training_data\": \"<tf.Tensor 'Const:0' shape=(950, 36) dtype=float32>\", \"labels\": \"<tf.Tensor 'Const:0' shape=(950,) dtype=float32>\", \"validation_split\": 0.0, \"validation_data\": \"(<tf.Tensor 'Const:0' shape=(510, 36) dtype=float32>, <tf.Tensor 'Const:0' shape=(510,) dtype=float32>)\"}",
					"outputDataExample": "{\"cerebros\": \"<SimpleCerebrosRandomSearch object>\"}"
				},
				{
					"simStepId": "fcb98fd8-6192-4c2e-b1b3-4fe35b41a27f",
					"diagramNodeId": "ec6b3c2e-52b8-4a93-865f-911dee1053cb",
					"simStepLabel": "Data Flow: Pass Split Data to Constructor",
					"simStepDescription": "The training data, labels, validation split parameter (0.0), and the custom validation dataset are passed into the `__init__` method of the `SimpleCerebrosRandomSearch` class.",
					"isEdge": 1,
					"sourceCodeMapping": {
