				}
			]
		},
		"78448410-428c-485d-a6eb-fa5fc8d991ef": {
			"path": "78448410-428c-485d-a6eb-fa5fc8d991ef",
			"cellName": "Logic: Calculate Lateral Connections - dense_automl_structural_component.py:L224-247",
