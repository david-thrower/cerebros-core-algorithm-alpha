		"kubeflow-pipeline/amesnopreprcoessing0002a-vnrny.katib.yaml-simstep-5be0b7e7-b96d-47b7-82e8-1c87a588d57a": {
			"path": "kubeflow-pipeline/amesnopreprcoessing0002a-vnrny.katib.yaml-simstep-5be0b7e7-b96d-47b7-82e8-1c87a588d57a",
			"fileName": "amesnopreprcoessing0002a-vnrny.katib.yaml",
			"wiki": "The Katib controller, a component of Kubeflow, detects the new `Experiment` resource. It uses the specified Bayesian Optimization algorithm to select a set of hyperparameter values from the defined search space for the first trial.",
			"cellName": "Flow 1: Katib Controller Generates Trial Parameters - amesnopreprcoessing0002a-vnrny.katib.yaml:L7-17",
			"cellId": "fdeab34a-7f82-4096-9845-11681ba0a60c",
