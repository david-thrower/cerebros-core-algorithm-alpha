		"875a150d-56bc-47cb-904a-dedcb2c16a7b": {
			"path": "875a150d-56bc-47cb-904a-dedcb2c16a7b",
			"cellName": "Flow 2: Return Metric to Optuna - generative-proof-of-concept-CPU-preprocessing-in-memory.py:L845",
			"cellId": "875a150d-56bc-47cb-904a-dedcb2c16a7b",
			"visible": true,
			"parentCellId": "4fc2fc00-1cfb-40a0-8f3b-13c06a963c99"
		},
		"generative-proof-of-concept-CPU-preprocessing-in-memory.py-simstep-00f0e229-a995-4fd5-942f-8ae96db14494": {
