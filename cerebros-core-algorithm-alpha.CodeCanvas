		"cifar-10-efficientnetv2s.py-simstep-0f9aa5c0-fe0a-4624-9f97-66f162642b8a": {
			"path": "cifar-10-efficientnetv2s.py-simstep-0f9aa5c0-fe0a-4624-9f97-66f162642b8a",
			"fileName": "cifar-10-efficientnetv2s.py",
			"wiki": "A complete Keras model is constructed. It starts with an Input layer matching the original CIFAR-10 image size (32x32x3), adds a Resizing layer to scale images up to what EfficientNet expects (384x384x3), and then passes the resized image to the feature extraction model. This pipeline becomes the `embedding_model`.",
			"cellName": "Build Full Preprocessing and Embedding Pipeline - cifar-10-efficientnetv2s.py:L110-120",
			"cellId": "d5862a33-6aa5-48b6-9241-165ee6538cd9",
			"visible": true,
			"startLine": 110,
			"endLine": 120,
			"parentCellId": "a633d4b1-7064-4023-b5d4-62b4296dac1b",
			"parentPath": "cifar-10-efficientnetv2s.py",
			"simSteps": [
				{
					"simulationKey": "High-Accuracy Image Classification via Neural Architecture Search on Pre-trained Vision Models",
					"simStepId": "0f9aa5c0-fe0a-4624-9f97-66f162642b8a"
				}
			]
		},
