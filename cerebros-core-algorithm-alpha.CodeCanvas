					"inputDataExample": "{\"EMBEDDING_DIM\": 12, \"MAX_SEQ_LENGTH\": 40}",
					"outputDataExample": "{\"cerebros_base_model\": \"<tf.keras.Model object>\"}"
				},
				{
					"simStepId": "547000e5-98aa-465e-8d2a-a758a9cbd291",
					"diagramNodeId": "678293af-73ec-4765-9859-cf81fbf4b29a",
					"simStepLabel": "Pass Data and Config to NAS",
					"simStepDescription": "The prepared training data, base model, and a large set of hyperparameters (for activation functions, learning rate, network structure, etc.) are passed to the `SimpleCerebrosRandomSearch` object to begin the neural architecture search.",
					"isEdge": 1,
					"sourceCodeMapping": {
