		"text-class-ham-or-spam.py-simstep-f7512f7c-77fb-4f56-8e0d-652dadb4934c": {
			"path": "text-class-ham-or-spam.py-simstep-f7512f7c-77fb-4f56-8e0d-652dadb4934c",
			"fileName": "text-class-ham-or-spam.py",
			"wiki": "A pre-trained BERT model from TensorFlow Hub is configured to serve as the base for text embedding. An input layer for string data is defined, connected to a preprocessor and an encoder from the hub. The output of this chain (`pooled_output`) is then wrapped in a Keras Model, which will be used as the feature extractor.",
			"cellName": "BERT Base Model Construction - text-class-ham-or-spam.py:L80-91",
			"cellId": "1514608b-dfcb-4f50-97cc-a72d7f5e49c0",
			"visible": true,
