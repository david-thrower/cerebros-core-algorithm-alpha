						]
					},
					"inputDataExample": "{\n  \"neural_network\": \"<tf.keras.Model object>\",\n  \"x\": [\"<tf.Tensor: shape=(200, 1), dtype=string>\"],\n  \"y\": [\"<tf.Tensor: shape=(200,), dtype=float32>\"],\n  \"epochs\": 6,\n  \"batch_size\": 13,\n  \"validation_split\": 0.35\n}",
					"outputDataExample": "{\n  \"neural_network\": \"<tf.keras.Model object>\",\n  \"x\": [\"<tf.Tensor: shape=(200, 1), dtype=string>\"],\n  \"y\": [\"<tf.Tensor: shape=(200,), dtype=float32>\"],\n  \"epochs\": 6,\n  \"batch_size\": 13,\n  \"validation_split\": 0.35\n}"
				},
				{
					"simStepId": "4ca6cfa9-8126-41e2-811d-8b532d88f3bd",
					"diagramNodeId": "c08a85f4-ee02-42b9-a287-30de66084bbf",
					"simStepLabel": "Model Training (Fine-tuning)",
					"simStepDescription": "The `fit` method is executed. TensorFlow computes gradients and updates weights for the entire model. Because the BERT encoder's `trainable` property was set to `True`, its weights are updated along with the weights of the newly generated classification layers. This process fine-tunes the pre-trained transformer for the specific spam detection task.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "cerebros/simplecerebrosrandomsearch/simple_cerebros_random_search.py",
						"startLine": "498",
						"endLine": "505",
						"relevantVariables": [
							"history",
							"neural_network.fit"
						]
					},
					"inputDataExample": "{\n  \"training_batch_x\": \"tf.Tensor(shape=(13, 1), dtype=string, ...)\",\n  \"training_batch_y\": \"tf.Tensor(shape=(13,), dtype=float32, ...)\"\n}",
					"outputDataExample": "{\n  \"history\": \"<keras.callbacks.History object>\",\n  \"logs\": {\n    \"loss\": 0.1523,\n    \"binary_accuracy\": 0.9634,\n    \"val_loss\": 0.1189,\n    \"val_binary_accuracy\": 0.9857\n  }\n}"
