		"Implementing Custom and Robust Data Splitting Strategies": {
			"name": "Implementing Custom and Robust Data Splitting Strategies",
			"simSteps": [
				{
					"simStepId": "42f30eb0-2ec9-4a79-8e9c-32ae03afc2a9",
					"diagramNodeId": "3bd80692-475d-4069-96d2-ea252bf41d36",
					"simStepLabel": "Load and Prepare Data",
					"simStepDescription": "The script begins by loading the 'ames.csv' dataset into a pandas DataFrame. It then selects only the numeric columns, fills any missing values with 0, and separates the features (data_numeric) from the target variable (label).",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "regression-example-ames-no-preproc-val-set.py",
						"startLine": "107",
						"endLine": "113",
						"relevantVariables": [
							"raw_data",
							"needed_cols",
							"data_numeric",
							"label",
							"LABEL_COLUMN"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\"data_numeric\": {\"MSSubClass\": [60, 20], \"LotArea\": [8450, 9600], \"OverallQual\": [7, 6]}, \"label\": [208500, 181500]}"
				},
				{
					"simStepId": "01f0925b-5398-44a2-bfc1-d7e1e65aec2a",
					"diagramNodeId": "984c3a1b-319b-46d4-89d4-c22524fdda3a",
					"simStepLabel": "Data Flow: Pass Data for Splitting",
					"simStepDescription": "The numeric feature DataFrame and the label Series are passed as arguments to the `hash_based_split` function to perform a deterministic split based on row content.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "regression-example-ames-no-preproc-val-set.py",
						"startLine": "117",
						"endLine": "121",
						"relevantVariables": [
							"hash_based_split",
							"data_numeric",
							"label"
						]
					},
					"inputDataExample": "{\"df\": {\"MSSubClass\": [60, 20], \"LotArea\": [8450, 9600], \"OverallQual\": [7, 6]}, \"labels\": [208500, 181500], \"test_size\": 0.35, \"hash_column\": \"*\"}",
					"outputDataExample": "{\"df\": {\"MSSubClass\": [60, 20], \"LotArea\": [8450, 9600], \"OverallQual\": [7, 6]}, \"labels\": [208500, 181500], \"test_size\": 0.35, \"hash_column\": \"*\"}"
				},
				{
					"simStepId": "49fd8f36-c695-4ba5-8514-de25575d264f",
					"diagramNodeId": "ad139ea1-5286-4830-93c4-018dd8452368",
					"simStepLabel": "Initiate Hash Calculation",
					"simStepDescription": "Inside `hash_based_split`, since `hash_column` is specified as '*', the function applies the `hash_a_row` function to each row of the input DataFrame to generate a unique hash value for every sample.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "regression-example-ames-no-preproc-val-set.py",
						"startLine": "68",
						"endLine": "71",
						"relevantVariables": [
							"hash_column",
							"df",
							"hash_a_row",
							"hash_values"
						]
					},
					"inputDataExample": "{\"df\": {\"MSSubClass\": 60, \"LotArea\": 8450, \"OverallQual\": 7, ...}}",
					"outputDataExample": "{\"hash_values\": [123456789012345, 987654321098765, ...]}"
				},
				{
					"simStepId": "13ba7fa9-0c91-4961-971e-c16bb6cb639a",
					"diagramNodeId": "9880950a-2f62-434f-bf2e-6c3a00f82655",
					"simStepLabel": "Data Flow: Pass Row for Hashing",
					"simStepDescription": "A single row of the DataFrame is passed to the `hash_a_row` helper function.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "regression-example-ames-no-preproc-val-set.py",
						"startLine": "70",
						"endLine": "71",
						"relevantVariables": [
							"df.apply",
							"hash_a_row"
						]
					},
					"inputDataExample": "{\"row\": [60, 8450, 7, 5, 2003, ...]}",
					"outputDataExample": "{\"row\": [60, 8450, 7, 5, 2003, ...]}"
				},
				{
					"simStepId": "e9306611-6c2a-481e-a021-b633301f4680",
					"diagramNodeId": "dcbada67-208c-4fda-a14e-5513cb8b23e2",
					"simStepLabel": "Compute Row Hash",
					"simStepDescription": "The `hash_a_row` function converts all cells in the row to strings, concatenates them, computes a standard hash, and returns the absolute (unsigned) value. This ensures that identical rows always produce the same hash.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "regression-example-ames-no-preproc-val-set.py",
						"startLine": "35",
						"endLine": "40",
						"relevantVariables": [
							"row",
							"str_cells",
							"cat_cells",
							"signed_hash",
							"unsigned_hash"
						]
					},
					"inputDataExample": "{\"row\": [60, 8450, 7, 5, 2003]}",
					"outputDataExample": "{\"unsigned_hash\": 123456789012345}"
				},
				{
					"simStepId": "8a924074-2c16-4148-8c51-587f3b3c82e3",
					"diagramNodeId": "473d1fb6-cf3e-43ed-bd5e-c4731caf81b0",
					"simStepLabel": "Data Flow: Return Hash Value",
					"simStepDescription": "The computed unsigned hash value for the row is returned to the `apply` function call within `hash_based_split`.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "regression-example-ames-no-preproc-val-set.py",
						"startLine": "40",
						"endLine": "40",
						"relevantVariables": [
							"unsigned_hash"
						]
					},
					"inputDataExample": "{\"unsigned_hash\": 123456789012345}",
					"outputDataExample": "{\"unsigned_hash\": 123456789012345}"
				},
				{
					"simStepId": "afbd8a41-5775-4cb9-af1f-76d4501677db",
					"diagramNodeId": "bc691654-0abb-4eca-ad5f-5a21b11057ec",
					"simStepLabel": "Perform Deterministic Split",
					"simStepDescription": "After collecting hash values for all rows, `hash_based_split` uses a modulus operation on the hashes to create a boolean mask (`train_idx`). This mask deterministically assigns each row to either the training or testing set, preventing data leakage for identical rows.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "regression-example-ames-no-preproc-val-set.py",
						"startLine": "83",
						"endLine": "101",
						"relevantVariables": [
							"hash_values",
							"test_size",
							"train_idx",
							"train_df",
							"test_df",
							"train_labels",
							"test_labels"
						]
					},
					"inputDataExample": "{\"hash_values\": [123456789012345, 987654321098765, ...], \"test_size\": 0.35}",
					"outputDataExample": "{\"train_df\": {\"MSSubClass\": [60], ...}, \"test_df\": {\"MSSubClass\": [20], ...}}"
				},
				{
					"simStepId": "9ade1ed5-60c2-4ba2-9285-1fe1f7f621d0",
					"diagramNodeId": "574a67b9-7e49-4cb2-bcc7-1c1d04a5a056",
					"simStepLabel": "Data Flow: Return Split Datasets",
					"simStepDescription": "The function returns the newly created training and validation DataFrames and label Series back to the main script's execution context.",
					"isEdge": 1,
					"sourceCodeMapping": {
