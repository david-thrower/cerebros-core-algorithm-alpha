							"tf.keras.Model"
						]
					},
					"inputDataExample": "{\n  \"inputs\": [\"<KerasTensor: shape=(None,) dtype=string>\"],\n  \"outputs\": [\"<KerasTensor: shape=(None, 1) dtype=float32>\"]\n}",
					"outputDataExample": "{\n  \"self.materialized_neural_network\": \"<tf.keras.Model object>\"\n}"
				},
				{
					"simStepId": "dfe4ef20-b3bd-4eab-8e55-9c4426cb03a9",
					"diagramNodeId": "93930905-fff9-46af-928b-ea6517e9d861",
					"simStepLabel": "Pass Compiled Model for Training",
					"simStepDescription": "The fully assembled and compiled Keras model, which now includes both the pre-trained BERT base and the new classification head, is passed to the `fit` method along with the training data and labels.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "cerebros/simplecerebrosrandomsearch/simple_cerebros_random_search.py",
						"startLine": "498",
						"endLine": "498",
						"relevantVariables": [
