					"inputDataExample": "{\n  \"status\": \"Starting Phase I-b training\"\n}",
					"outputDataExample": "{\n  \"history\": {\n    \"perplexity_phase_i_b\": [35.2, 31.5, 29.8]\n  }\n}"
				},
				{
					"simStepId": "985169ca-bc48-4729-bb6d-99537ba7fe08",
					"diagramNodeId": "fb7637d8-fc25-4c71-8be2-5ac5f302729f",
					"simStepLabel": "Log Phase I-b Perplexity Metric",
					"simStepDescription": "Upon completion of Phase I-b, the script finds the minimum perplexity achieved during this phase from the training history and logs it to MLflow using `mlflow.log_metric()`. This value is the final objective score for the Optuna trial.",
