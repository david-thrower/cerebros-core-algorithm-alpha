		"8848ea77-1efb-49c2-b732-baa7b7d44c30": {
			"path": "8848ea77-1efb-49c2-b732-baa7b7d44c30",
			"cellName": "Flow 2: Suggest Hyperparameters and Start MLflow Run - generative-proof-of-concept-CPU-preprocessing-in-memory.py:L117-216",
			"cellId": "8848ea77-1efb-49c2-b732-baa7b7d44c30",
			"visible": true,
			"parentCellId": "4fc2fc00-1cfb-40a0-8f3b-13c06a963c99"
		},
		"generative-proof-of-concept-CPU-preprocessing-in-memory.py-simstep-d95bfee2-d86b-429c-8eb1-06cf69f83976": {
			"path": "generative-proof-of-concept-CPU-preprocessing-in-memory.py-simstep-d95bfee2-d86b-429c-8eb1-06cf69f83976",
			"fileName": "generative-proof-of-concept-CPU-preprocessing-in-memory.py",
			"wiki": "Inside the `objective` function, the `trial.suggest_*` methods are called to get hyperparameter values for the current trial. An MLflow run is then started using `with mlflow.start_run()` to create a tracking context for this specific trial.",
			"cellName": "Flow 2: Suggest Hyperparameters and Start MLflow Run - generative-proof-of-concept-CPU-preprocessing-in-memory.py:L117-216",
