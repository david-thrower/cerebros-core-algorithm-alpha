					"simStepLabel": "Log Hyperparameters to MLflow",
					"simStepDescription": "The `mlflow.log_params()` function sends the hyperparameter dictionary to the MLflow server, where it is associated with the active run. This makes it possible to compare the parameters of different trials.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "generative-proof-of-concept-CPU-preprocessing-in-memory.py",
						"startLine": "218",
						"endLine": "218",
						"relevantVariables": [
