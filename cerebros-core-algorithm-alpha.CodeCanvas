					},
					"inputDataExample": "{\n  \"key\": \"phase-i-a-perplexity\",\n  \"value\": 45.8,\n  \"step\": 0\n}",
					"outputDataExample": "{\n  \"status\": \"SUCCESS\"\n}"
				},
				{
					"simStepId": "8a78dbe8-9637-49b7-a0e4-a75368312afc",
					"diagramNodeId": "8c2fd1c6-e436-49cb-868c-2168b84e4933",
					"simStepLabel": "Execute Phase I-b Training",
					"simStepDescription": "The second phase of training (fine-tuning) is initiated by calling `generator.model.fit()`. This phase uses a different dataset and potentially different learning parameters.",
					"isEdge": 1,
					"sourceCodeMapping": {
