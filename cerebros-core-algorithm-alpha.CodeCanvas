		"generative-proof-of-concept-CPU-preprocessing-in-memory.py-simstep-85d1eb83-98b5-492e-9911-7bbdd18dc83c": {
			"path": "generative-proof-of-concept-CPU-preprocessing-in-memory.py-simstep-85d1eb83-98b5-492e-9911-7bbdd18dc83c",
			"fileName": "generative-proof-of-concept-CPU-preprocessing-in-memory.py",
			"wiki": "The `mlflow.log_params()` function sends the hyperparameter dictionary to the MLflow server, where it is associated with the active run. This makes it possible to compare the parameters of different trials.",
