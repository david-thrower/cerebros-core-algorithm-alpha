					"inputDataExample": "{\n  \"params\": {\n    \"POSITIONAL_EMBEDDING_DROPOUT\": 0.75,\n    \"activation\": \"gelu\",\n    \"learning_rate\": 0.0045,\n    \"epochs\": 50\n  }\n}",
					"outputDataExample": "{\n  \"params\": {\n    \"POSITIONAL_EMBEDDING_DROPOUT\": 0.75,\n    \"activation\": \"gelu\",\n    \"learning_rate\": 0.0045,\n    \"epochs\": 50\n  }\n}"
				},
				{
					"simStepId": "85d1eb83-98b5-492e-9911-7bbdd18dc83c",
