		"kubeflow-pipeline/amesnopreprcoessing0002a-vnrny.katib.yaml-simstep-83a4230e-dd38-4d06-ad3a-2e691e1b9824": {
			"path": "kubeflow-pipeline/amesnopreprcoessing0002a-vnrny.katib.yaml-simstep-83a4230e-dd38-4d06-ad3a-2e691e1b9824",
			"fileName": "amesnopreprcoessing0002a-vnrny.katib.yaml",
			"wiki": "A user defines a Kubeflow Katib `Experiment` in a YAML file. This specification includes the hyperparameter search space (`parameters`), the optimization algorithm (`bayesianoptimization`), the objective metric to minimize (`val-root-mean-squared-error`), and a `trialTemplate` that defines how to run each training job.",
			"cellName": "Flow 1: Define Katib Experiment - amesnopreprcoessing0002a-vnrny.katib.yaml:L1-134",
			"cellId": "320af148-a754-4f7a-8a8c-56271c8d1a8d",
