					"inputDataExample": "{\"cerebros_automl\": \"<SimpleCerebrosRandomSearch object>\"}",
					"outputDataExample": "{\"phase_i_a_result\": 45.8, \"best_model\": \"<tf.keras.Model object>\"}"
				},
				{
					"simStepId": "288469a7-a5ba-4f0c-9a0a-538d855c81a7",
					"diagramNodeId": "b5184d39-f277-4258-a177-47186a594c9f",
					"simStepLabel": "Retrieve Best Trained Model",
					"simStepDescription": "After the search is complete, the best performing model (foundation model) is retrieved from the `SimpleCerebrosRandomSearch` instance.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "generative-proof-of-concept-CPU-preprocessing-in-memory.py",
						"startLine": "385",
