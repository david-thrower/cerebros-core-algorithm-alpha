							"all_input_ids",
							"all_labels",
							"vocab_size"
						]
					},
					"inputDataExample": "{\"data_0\": [\"In the beginning God created the heavens and the earth.\"], \"tokenizer_0\": \"<AutoTokenizer object>\", \"max_seq_length\": 40, \"prompt_length\": 1}",
