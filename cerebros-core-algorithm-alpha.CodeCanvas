			"fileName": "generative-proof-of-concept-CPU-preprocessing-in-memory.py",
			"wiki": "After Phase I-a training completes, the resulting best perplexity score is logged to MLflow using `mlflow.log_metric()`. This captures the performance of the model found during the architecture search.",
			"cellName": "Log Phase I-a Perplexity Metric - generative-proof-of-concept-CPU-preprocessing-in-memory.py:L379",
