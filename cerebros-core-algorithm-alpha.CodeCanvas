					"simulationKey": "Scalable Hyperparameter Optimization with MLOps Tools",
					"simStepId": "98fd8b19-fb77-42cc-983f-a74550303185"
				}
			]
		},
		"508d16a2-add8-4999-b243-5d084793c8e0": {
			"path": "508d16a2-add8-4999-b243-5d084793c8e0",
			"cellName": "Flow 2: Start Optimization Loop - generative-proof-of-concept-CPU-preprocessing-in-memory.py:L852",
			"cellId": "508d16a2-add8-4999-b243-5d084793c8e0",
			"visible": true,
			"parentCellId": "4fc2fc00-1cfb-40a0-8f3b-13c06a963c99"
		},
		"generative-proof-of-concept-CPU-preprocessing-in-memory.py-simstep-c957148a-7524-47b5-b6a0-538775aa0caa": {
			"path": "generative-proof-of-concept-CPU-preprocessing-in-memory.py-simstep-c957148a-7524-47b5-b6a0-538775aa0caa",
			"fileName": "generative-proof-of-concept-CPU-preprocessing-in-memory.py",
			"wiki": "The `study.optimize()` method is called, which starts the hyperparameter search loop. For each of the `N_TRIALS`, it will invoke the `objective` function to run one evaluation.",
			"cellName": "Flow 2: Start Optimization Loop - generative-proof-of-concept-CPU-preprocessing-in-memory.py:L852",
			"cellId": "508d16a2-add8-4999-b243-5d084793c8e0",
