				{
					"simStepId": "7e6dbeaf-efe4-4dc5-93cb-decfe374127f",
					"diagramNodeId": "0224d42a-557c-48a3-8448-0645c06a7391",
					"simStepLabel": "Wrap Model for Generation",
					"simStepDescription": "The best model is wrapped inside a `CerebrosNotGPT` object. This class provides a high-level `generate` method that encapsulates the logic for autoregressive text generation, including sampling strategies.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "generative-proof-of-concept-CPU-preprocessing-in-memory.py",
						"startLine": "397",
						"endLine": "401",
						"relevantVariables": [
