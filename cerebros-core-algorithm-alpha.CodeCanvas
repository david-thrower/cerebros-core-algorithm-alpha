		"generative-proof-of-concept-CPU-preprocessing-in-memory.py-simstep-fa74f512-4678-46ce-860c-600525853b2f": {
			"path": "generative-proof-of-concept-CPU-preprocessing-in-memory.py-simstep-fa74f512-4678-46ce-860c-600525853b2f",
			"fileName": "generative-proof-of-concept-CPU-preprocessing-in-memory.py",
			"wiki": "Inside the `objective` function, `mlflow.start_run()` is called within a `with` block. This creates a new, nested run for the specific Optuna trial, allowing for isolated tracking of its parameters and metrics.",
			"cellName": "Start Nested MLflow Run for Optuna Trial - generative-proof-of-concept-CPU-preprocessing-in-memory.py:L216",
