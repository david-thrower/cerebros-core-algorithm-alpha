		"cerebros/units/units.py-simstep-e0d440ee-f76a-4ee7-a278-16bfd6b6ae10": {
			"path": "cerebros/units/units.py-simstep-e0d440ee-f76a-4ee7-a278-16bfd6b6ae10",
			"fileName": "units.py",
			"wiki": "The `parse_predecessor_connections_to_level` method uses the `predecessor_level_connection_affinity_factor_main` parameter to calculate the number of connections to make to units in a predecessor level. The `maximum_skip_connection_depth` parameter implicitly constrains which predecessor levels are considered.",
			"cellName": "Logic: Calculate Vertical Connections - units.py:L356-365",
			"cellId": "4f853480-d675-4d93-86c0-1aa9e251a514",
			"visible": true,
			"startLine": 356,
			"endLine": 365,
			"parentCellId": "7b9394cf-4e6d-420d-99a3-3fad0b7575c0",
