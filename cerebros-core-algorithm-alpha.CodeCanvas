		"8d431fd9-5716-43dd-b895-282679012b7f": {
			"path": "8d431fd9-5716-43dd-b895-282679012b7f",
			"cellName": "Flow 1: Katib Controller Updates Experiment Status - text-classification-100-percent-accuracy.yaml:L284-316",
			"cellId": "8d431fd9-5716-43dd-b895-282679012b7f",
			"visible": true,
			"parentCellId": "336af02a-8c6f-43c7-b031-531938930b87"
		},
		"experimental/text-classification/text-classification-100-percent-accuracy.yaml-simstep-b493a9b6-d8b4-4076-9d6d-afa9e3f4a2e8": {
			"path": "experimental/text-classification/text-classification-100-percent-accuracy.yaml-simstep-b493a9b6-d8b4-4076-9d6d-afa9e3f4a2e8",
			"fileName": "text-classification-100-percent-accuracy.yaml",
			"wiki": "The Katib controller's metrics collector parses the log from the completed trial, extracts the metric value, and updates the `Experiment` status. The Bayesian optimization algorithm uses this new data point to inform the next set of hyperparameters. It also updates the `currentOptimalTrial` if the current trial is the best one so far.",
			"cellName": "Flow 1: Katib Controller Updates Experiment Status - text-classification-100-percent-accuracy.yaml:L284-316",
			"cellId": "8d431fd9-5716-43dd-b895-282679012b7f",
			"visible": true,
			"startLine": 284,
			"endLine": 316,
